{
  "version": 2,
  "routes": [
    {
      "src": "/draaiboek.js",
      "dest": "/draaiboek.js"
    },
    {
      "src": "/sabine.vcf",
      "dest": "/sabine.vcf",
      "headers": {
        "Content-Type": "text/vcard; charset=utf-8"
      }
    },
    {
      "src": "/welkom",
      "dest": "/welkom.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    }
  ]
}